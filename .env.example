# 実ファイルは ~/.claude-skills-env/oura-collection-app.env に置く。値は本人の環境に依るので、スキルの中には書かない。
# Ouraの認証情報はここではなく、oura-api-generic-logic の環境ファイルに置く。
# NotionのトークンはNotionの、notion-cli-generic-logic の環境ファイルに置く。

# 記録先のNotionのDBのURL(DBのページのURL)。「OuraRing」ページ配下の5つ。
OURA_COLLECTION_DB_DAILY_URL=
OURA_COLLECTION_DB_SLEEP_URL=
OURA_COLLECTION_DB_SESSION_URL=
OURA_COLLECTION_DB_WORKOUT_URL=
OURA_COLLECTION_DB_TAG_URL=
